// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
// PostgreSQL, on any host. DATABASE_URL is a standard connection string, for example
// postgresql://user:password@host:5432/database?sslmode=require
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model PromotionSettings {
  id                 Int      @id @default(autoincrement())

  shop               String
  shopifyDiscountId  String

  included           Boolean  @default(true)
  websiteEnabled     Boolean  @default(false)

  showProductPage    Boolean  @default(false)
  showCollectionPage Boolean  @default(false)
  showProductBadge   Boolean  @default(false)
  showCountdown      Boolean  @default(false)
  showHeaderBanner   Boolean  @default(false)

  headline           String?
  body               String?
  badgeText          String?
  countdownText      String?
  buttonText         String?
  buttonUrl          String?

  backgroundColour   String?
  textColour         String?
  badgeColour        String?

  designJson         String?

  priority           Int      @default(0)

  lastSyncedAt       DateTime?
  lastSyncError      String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([shop, shopifyDiscountId])
  @@index([shop])
}

model PromotionCodeBatch {
  id                   String   @id @default(cuid())
  shop                 String
  requestKey           String
  shopifyDiscountId    String?
  configurationJson    String
  codesJson            String
  confirmedJson        String   @default("[]")
  pendingJson          String   @default("[]")
  activeJobId          String?
  reconciliationCursor String?
  reconciliationJson   String   @default("[]")
  status               String   @default("NEW")
  error                String?
  leaseToken           String?
  leaseUntil           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  @@unique([shop, requestKey])
  @@index([shop, shopifyDiscountId])
}

// A group in the Reports page: discounts whose code or title matches a pattern are counted together, for example
// every code starting SIGNUP- as "Signup". One row per group, in the order the merchant arranged them.
model ReportGroup {
  id        Int      @id @default(autoincrement())
  shop      String
  name      String
  matchOn   String   @default("either")
  matchType String   @default("starts_with")
  pattern   String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop])
}

// How many times each used discount had been redeemed at one moment, for the Reports page. Shopify only reports
// lifetime totals, so the redemptions in a period are the difference between two snapshots. rowsJson holds one entry
// per discount that has been used: id, title, first code, kind, creating app and uses.
model ReportSnapshot {
  id            Int      @id @default(autoincrement())
  shop          String
  takenAt       DateTime @default(now())
  complete      Boolean  @default(true)
  discountCount Int      @default(0)
  rowsJson      String

  @@index([shop, takenAt])
}
