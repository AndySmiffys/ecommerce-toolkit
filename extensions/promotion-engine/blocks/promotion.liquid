<script src="{{ 'promotion-ui.js' | asset_url }}" defer></script>
{% assign placement = block.settings.placement %}
{% assign preview_product = block.settings.product | default: closest.product | default: product %}
{% assign preview_collection = closest.collection | default: collection %}
{% assign maximum_width = block.settings.max_width %}
{% if placement == 'collection' and block.settings.collection_full_width != false %}{% assign maximum_width = nil %}{% endif %}
{% assign storefront_snapshot = app.metafields.promotion_engine.storefront.value %}
{% assign storefront_metafields = app.metafields.promotion_engine %}
{% render 'server-promotion', snapshot: storefront_snapshot, metafields: storefront_metafields, maximum_width: maximum_width, placement: placement, current_product: preview_product, current_collection: preview_collection, block: block %}
{% schema %}
{
  "name": "Toolkit promotion",
  "target": "section",
  "javascript": "promotion-engine.js",
  "stylesheet": "promotion-layout.css",
  "class": "pe-promotion-app-block",
  "settings": [
    {"type":"select","id":"placement","label":"Placement","default":"product","options":[{"value":"header","label":"Header announcement"},{"value":"collection","label":"Collection banner"},{"value":"product","label":"Product offer"},{"value":"badge","label":"Product badge"}]},
    {"type":"product","id":"product","label":"Product (optional)","info":"Leave blank to use the current product."},
    {"type":"checkbox","id":"collection_full_width","label":"Full-width collection banner","default":true,"info":"Fill the theme section’s available width. Turn off to use the maximum width below."},
    {"type":"range","id":"max_width","label":"Maximum width","min":320,"max":1600,"step":40,"unit":"px","default":1200},
    {"type":"range","id":"spacing","label":"Space above and below","min":0,"max":64,"step":4,"unit":"px","default":0}
  ]
}
{% endschema %}
