<script src="{{ 'promotion-ui.js' | asset_url }}" defer></script>
{% assign current_product = closest.product | default: product %}
{% assign storefront_snapshot = app.metafields.promotion_engine.storefront.value %}
{% assign storefront_metafields = app.metafields.promotion_engine %}
{% render 'server-promotion', snapshot: storefront_snapshot, metafields: storefront_metafields, placement: 'product', current_product: current_product, block: block %}
{% schema %}
{
  "name": "Product promotion",
  "target": "section",
  "enabled_on": {"templates": ["product"]},
  "class": "pe-product-app-block",
  "javascript": "promotion-engine.js",
  "stylesheet": "promotion-layout.css",
  "settings": [
    {"type":"paragraph","content":"Place beside the product details. Uses the current product and selected variant. Promotion content and styling are managed in the app."},
    {"type":"range","id":"spacing","label":"Space above and below","min":0,"max":64,"step":4,"unit":"px","default":0}
  ]
}
{% endschema %}
